<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.pi-voice</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VOICE_DIR__/start-pi-voice-server.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__PACKAGE_DIR__</string>
  <key>StandardOutPath</key>
  <string>__VOICE_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__VOICE_DIR__/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PI_VOICE_MODEL</key>
    <string>q8</string>
  </dict>
</dict>
</plist>
