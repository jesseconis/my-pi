{
  "enabled": true,
  "backend": "local",
  "voice": "af_heart",
  "speed": 1.0,
  "host": "127.0.0.1",
  "port": 8181,
  "defaultModel": "q8",
  "remote": {
    "baseUrl": "https://tts.example.com",
    "authToken": "",
    "speechPath": "/v1/audio/speech",
    "streamPath": "/v1/audio/speech/stream",
    "stream": true,
    "streamFormat": "pcm",
    "chunkText": true,
    "chunkMaxChars": 240
  },
  "stt": {
    "enabled": true,
    "mode": "local",
    "language": "en",
    "audioCues": true
  },
  "speech": {
    "queue": {
      "onUserInput": "interrupt",
      "inputSources": ["interactive", "rpc"]
    },
    "processing": {
      "defaultProfile": "monitor",
      "pronunciationFile": "pronunciations.json",
      "profiles": {
        "monitor": {
          "base": "technical",
          "limits": {
            "maxLines": 12,
            "maxChars": 1200
          },
          "code": {
            "shortMaxLines": 3,
            "shortMaxChars": 240,
            "longMode": "outline"
          },
          "toolOutput": {
            "headLines": 6,
            "tailLines": 4,
            "longMode": "bounded"
          }
        },
        "monitorWithLlm": {
          "base": "technical",
          "code": {
            "longMode": "llm"
          },
          "toolOutput": {
            "longMode": "llm"
          }
        }
      }
    }
  },
  "events": {
    "message_update": {
      "content": "thinking",
      "roles": ["assistant"],
      "profile": "monitor"
    },
    "message_end": {
      "content": "text",
      "roles": ["assistant", "toolResult"],
      "profile": "monitor"
    }
  }
}
